<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="dev11">


    <xacro:property name="parent_link" value="body_link" scope="parent" />
    <xacro:property name="xyz" value="0 0 0"  scope="parent" />
    <xacro:property name="rpy" value="0 0 0" scope="parent" />


    <joint name="dev11_joint" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}" />
      <parent link="${parent_link}" />
      <child link="dev11_link" />
    </joint>

    <link name="dev11_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://husarion_components_description/meshes/devs/dev11.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.0725 0 ${0.14 + 0.0315 + 0.03}" rpy="0 0 0" />
        <geometry>
          <box size="0.66 0.53 0.06"/>
        </geometry>
      </collision>
      <collision>
        <origin xyz="${0.0725 + 0.295} ${(0.53-0.04)/2.0} ${0.14 + 0.0315 + 0.06 + 0.21}" rpy="0 0 0" />
        <geometry>
          <box size="0.06 0.04 0.42"/>
        </geometry>
      </collision>
      <collision>
        <origin xyz="${0.0725 + 0.295} ${-(0.53-0.04)/2.0} ${0.14 + 0.0315 + 0.06 + 0.21}" rpy="0 0 0" />
        <geometry>
          <box size="0.06 0.04 0.42"/>
        </geometry>
      </collision>
      <collision>
        <origin xyz="${0.0725 + 0.295} 0.0 ${0.14 + 0.0315 + 0.06 + 0.42 + 0.04}" rpy="0 0 0" />
        <geometry>
          <box size="0.06 0.81 0.08"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.1783 0.0 ${0.14 + 0.0315 + 0.317}" rpy="0.0 0.0 0.0" />
        <mass value="5.0" />
        <inertia ixx="0.4258" ixy="0.0" ixz="0.0"
                              iyy="0.4342" iyz="0.0"
                                           izz="0.5279" />
      </inertial>

    </link>

    <link name="dev11_mount_link"/>

    <joint name="dev11_mount_joint" type="fixed">
      <origin xyz="${0.0725 + 0.295} 0.0 ${0.14 + 0.0315 + 0.06 + 0.42 + 0.08}" rpy="0 0 0" />
      <parent link="dev11_link" />
      <child link="dev11_mount_link" />
    </joint>

  </xacro:macro>
</robot>
