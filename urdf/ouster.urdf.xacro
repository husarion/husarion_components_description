<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="ouster"
               params="parent_link
                       xyz:='0.0 0.0 0.0'
                       rpy:='0.0 0.0 0.0'
                       model:=os1_32
                       robot_namespace:=''
                       component_name:=''
                       use_tf_prefix:=True">

    <!-- <xacro:if value="${component_name == ''}">
      <xacro:property name="component_name" value="ouster" />
    </xacro:if> -->
    <!-- ^ removed for compatibility with hw driver -->

    <xacro:property name="robot_namespace_slash" value="${robot_namespace + '/' if robot_namespace != '' else ''}" />
    <xacro:property name="tf_prefix" value="${robot_namespace_slash if use_tf_prefix in ['True', True] else ''}" />
    <xacro:property name="component_name_underscore" value="${component_name + '_' if component_name != '' else ''}" />
    <xacro:property name="component_name_slash" value="${component_name + '/' if component_name != '' else ''}" />

    <xacro:property name="component_name_underscore_nonempty" value="${component_name_underscore if component_name_underscore != '' else 'ouster_'}" />
    <!-- ^ in case no name is provided, generate "..._link" instead of just "link" -->

    <!-- Defaults (OS0/OS1 geometry), overridden per model below where needed -->
    <xacro:property name="mesh_ext" value=".dae" />
    <xacro:property name="visual_rpy" value="0.0 0.0 0.0" />
    <xacro:property name="lidar_z" value="0.03618" />
    <xacro:property name="collision">
      <origin xyz="0.0 0.0 ${0.015+0.074/2.0}" rpy="0.0 0.0 0.0" />
      <geometry>
        <cylinder radius="${0.085/2.0}" length="${0.015+0.074}" /> <!-- base + lidar height -->
      </geometry>
    </xacro:property>
    <xacro:property name="inertial">
      <origin xyz="0.0 0.0 ${0.072/2.0}" rpy="0.0 0.0 0.0" />
      <mass value="0.447" />
      <inertia ixx="0.00047706" ixy="0.0"        ixz="0.0"
                                iyy="0.00047706" iyz="0.0"
                                                 izz="0.00053722" />
    </xacro:property>

    <xacro:if value="${model == 'os0_32'}">
      <xacro:property name="vfov" value="${radians(90.0)}" scope="parent" />
      <xacro:property name="range_min" value="0.4" scope="parent"/>
      <xacro:property name="range_max" value="35" scope="parent"/>
      <xacro:property name="layers" value="32" scope="parent"/>
      <xacro:property name="mesh" value="ouster_os01" scope="parent"/>
      <xacro:property name="precision" value="0.008" scope="parent"/>
    </xacro:if>

    <xacro:if value="${model == 'os0_64'}">
      <xacro:property name="vfov" value="${radians(90.0)}" scope="parent" />
      <xacro:property name="range_min" value="0.4" scope="parent" />
      <xacro:property name="range_max" value="35" scope="parent" />
      <xacro:property name="layers" value="64" scope="parent" />
      <xacro:property name="mesh" value="ouster_os01" scope="parent"/>
      <xacro:property name="precision" value="0.008" scope="parent"/>
    </xacro:if>

    <xacro:if value="${model == 'os0_128'}">
      <xacro:property name="vfov" value="${radians(90.0)}" scope="parent" />
      <xacro:property name="range_min" value="0.4" scope="parent" />
      <xacro:property name="range_max" value="35" scope="parent" />
      <xacro:property name="layers" value="128" scope="parent" />
      <xacro:property name="mesh" value="ouster_os01" scope="parent"/>
      <xacro:property name="precision" value="0.008" scope="parent"/>
    </xacro:if>

    <xacro:if value="${model == 'os1_32'}">
      <xacro:property name="vfov" value="${radians(42.4)}" scope="parent" />
      <xacro:property name="range_min" value="0.5" scope="parent" />
      <xacro:property name="range_max" value="90" scope="parent" />
      <xacro:property name="layers" value="32" scope="parent" />
      <xacro:property name="mesh" value="ouster_os01" scope="parent"/>
      <xacro:property name="precision" value="0.005" scope="parent"/>
    </xacro:if>

    <xacro:if value="${model == 'os1_64'}">
      <xacro:property name="vfov" value="${radians(42.4)}" scope="parent" />
      <xacro:property name="range_min" value="0.5" scope="parent" />
      <xacro:property name="range_max" value="90" scope="parent" />
      <xacro:property name="layers" value="64" scope="parent" />
      <xacro:property name="mesh" value="ouster_os01" scope="parent"/>
      <xacro:property name="precision" value="0.005" scope="parent"/>
    </xacro:if>

    <xacro:if value="${model == 'os1_128'}">
      <xacro:property name="vfov" value="${radians(42.4)}" scope="parent" />
      <xacro:property name="range_min" value="0.5" scope="parent" />
      <xacro:property name="range_max" value="90" scope="parent" />
      <xacro:property name="layers" value="128" scope="parent" />
      <xacro:property name="mesh" value="ouster_os01" scope="parent"/>
      <xacro:property name="precision" value="0.005" scope="parent"/>
    </xacro:if>

    <xacro:if value="${model == 'os2_32'}">
      <!-- Spec: https://data.ouster.io/downloads/datasheets/datasheet-rev7-v3p1-os2.pdf -->
      <xacro:property name="vfov" value="${radians(22.5)}" scope="parent" />
      <xacro:property name="range_min" value="0.8" scope="parent" />
      <xacro:property name="range_max" value="200" scope="parent" />
      <xacro:property name="layers" value="32" scope="parent" />
      <xacro:property name="mesh" value="ouster_os2" scope="parent"/>
      <xacro:property name="precision" value="0.02" scope="parent"/>
      <xacro:property name="mesh_ext" value=".glb" />
      <xacro:property name="visual_rpy" value="${pi/2} 0.0 0.0" />
      <xacro:property name="lidar_z" value="0.078296" />
      <xacro:property name="collision">
        <origin xyz="0.0 0.0 0.05145" rpy="0.0 0.0 0.0" />
        <geometry>
          <cylinder radius="0.0598" length="0.1029" />
        </geometry>
      </xacro:property>
      <!-- mass: datasheet; inertia: solid cylinder approximation of the collision geometry -->
      <xacro:property name="inertial">
        <origin xyz="0.0 0.0 0.05145" rpy="0.0 0.0 0.0" />
        <mass value="1.1" />
        <inertia ixx="0.001954" ixy="0.0"      ixz="0.0"
                                iyy="0.001954" iyz="0.0"
                                               izz="0.001967" />
      </xacro:property>
    </xacro:if>

    <xacro:if value="${model == 'os2_64'}">
      <!-- Spec: https://data.ouster.io/downloads/datasheets/datasheet-rev7-v3p1-os2.pdf -->
      <xacro:property name="vfov" value="${radians(22.5)}" scope="parent" />
      <xacro:property name="range_min" value="0.8" scope="parent" />
      <xacro:property name="range_max" value="200" scope="parent" />
      <xacro:property name="layers" value="64" scope="parent" />
      <xacro:property name="mesh" value="ouster_os2" scope="parent"/>
      <xacro:property name="precision" value="0.02" scope="parent"/>
      <xacro:property name="mesh_ext" value=".glb" />
      <xacro:property name="visual_rpy" value="${pi/2} 0.0 0.0" />
      <xacro:property name="lidar_z" value="0.078296" />
      <xacro:property name="collision">
        <origin xyz="0.0 0.0 0.05145" rpy="0.0 0.0 0.0" />
        <geometry>
          <cylinder radius="0.0598" length="0.1029" />
        </geometry>
      </xacro:property>
      <!-- mass: datasheet; inertia: solid cylinder approximation of the collision geometry -->
      <xacro:property name="inertial">
        <origin xyz="0.0 0.0 0.05145" rpy="0.0 0.0 0.0" />
        <mass value="1.1" />
        <inertia ixx="0.001954" ixy="0.0"      ixz="0.0"
                                iyy="0.001954" iyz="0.0"
                                               izz="0.001967" />
      </xacro:property>
    </xacro:if>

    <xacro:if value="${model == 'os2_128'}">
      <!-- Spec: https://data.ouster.io/downloads/datasheets/datasheet-rev7-v3p1-os2.pdf -->
      <xacro:property name="vfov" value="${radians(22.5)}" scope="parent" />
      <xacro:property name="range_min" value="0.8" scope="parent" />
      <xacro:property name="range_max" value="200" scope="parent" />
      <xacro:property name="layers" value="128" scope="parent" />
      <xacro:property name="mesh" value="ouster_os2" scope="parent"/>
      <xacro:property name="precision" value="0.02" scope="parent"/>
      <xacro:property name="mesh_ext" value=".glb" />
      <xacro:property name="visual_rpy" value="${pi/2} 0.0 0.0" />
      <xacro:property name="lidar_z" value="0.078296" />
      <xacro:property name="collision">
        <origin xyz="0.0 0.0 0.05145" rpy="0.0 0.0 0.0" />
        <geometry>
          <cylinder radius="0.0598" length="0.1029" />
        </geometry>
      </xacro:property>
      <!-- mass: datasheet; inertia: solid cylinder approximation of the collision geometry -->
      <xacro:property name="inertial">
        <origin xyz="0.0 0.0 0.05145" rpy="0.0 0.0 0.0" />
        <mass value="1.1" />
        <inertia ixx="0.001954" ixy="0.0"      ixz="0.0"
                                iyy="0.001954" iyz="0.0"
                                               izz="0.001967" />
      </xacro:property>
    </xacro:if>

    <joint name="${parent_link.rstrip('_link')}_to_${component_name_underscore_nonempty}joint" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}" />
      <parent link="${parent_link}" />
      <child link="${component_name_underscore_nonempty}link" />
    </joint>

    <link name="${component_name_underscore_nonempty}link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="${visual_rpy}" />
        <geometry>
          <mesh filename="package://husarion_components_description/meshes/${mesh}${mesh_ext}" />
        </geometry>
      </visual>

      <collision>
        <xacro:insert_block name="collision" />
      </collision>

      <inertial>
        <xacro:insert_block name="inertial" />
      </inertial>
    </link>

    <joint name="${component_name_underscore_nonempty}to_${component_name_underscore}os_lidar_joint" type="fixed">
      <origin xyz="0.0 0.0 ${lidar_z}" rpy="0.0 0.0 0.0" />
      <parent link="${component_name_underscore_nonempty}link" />
      <child link="${component_name_underscore}os_lidar" />
    </joint>

    <link name="${component_name_underscore}os_lidar" />

    <gazebo reference="${component_name_underscore}os_lidar">
      <!-- gpu_lidar has to be set, CPU lidar doesn't work in ignition -
      https://github.com/gazebosim/gz-sensors/issues/26 -->
      <sensor type="gpu_lidar" name="${robot_namespace_slash}${component_name_underscore}lidar">
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>1024</samples>
              <resolution>1</resolution>
              <min_angle>-${pi}</min_angle>
              <max_angle>${pi}</max_angle>
            </horizontal>
            <vertical>
              <samples>${layers}</samples>
              <resolution>1</resolution>
              <min_angle>${vfov/-2.0}</min_angle>
              <max_angle>${vfov/2.0}</max_angle>
            </vertical>
          </scan>
          <range>
            <min>${range_min}</min>
            <max>${range_max}</max>
            <resolution>0.001</resolution>
          </range>

          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>${precision}</stddev>
          </noise>
        </ray>

        <update_rate>20.0</update_rate>

        <topic>${robot_namespace_slash}${component_name_slash}ouster/points</topic>
        <gz_frame_id>${tf_prefix}${component_name_underscore}os_lidar</gz_frame_id>
        <always_on>true</always_on>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
