<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wibotic_station">

  <xacro:arg name="component_name" default="" />
  <xacro:arg name="apriltag_image_path" default="" />
  <xacro:arg name="apriltag_size" default="0.07" />

  <xacro:macro name="wibotic_station"
               params="parent_link
                       xyz:='0.0 0.0 0.0'
                       rpy:='0.0 0.0 0.0'
                       component_name:=''">

    <xacro:if value="${component_name == ''}">
      <xacro:property name="component_name" value="wibotic_station" />
    </xacro:if>

    <xacro:property name="component_name_underscore" value="${component_name + '_' if component_name != '' else ''}" />

    <joint name="${parent_link.rstrip('_link')}_to_${component_name_underscore}joint" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}" />
      <parent link="${parent_link}" />
      <child link="${component_name_underscore}link" />
    </joint>

    <link name="${component_name_underscore}link">
      <!-- <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${pi/2.0}" />
        <geometry>
          <mesh filename="package://husarion_components_description/meshes/wibotic_station.stl" />
        </geometry>
      </visual> -->

      <!-- TODO Remove simple visuals when mesh is ready -->
      <visual>
        <origin xyz="-0.2 0.0  0.4" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.4 0.5 0.8" />
        </geometry>
        <material name="LightGrey">
          <color rgba="0.6 0.6 0.6 1.0" />
        </material>
      </visual>

      <!-- Fake collision fit to STL -->
      <collision>
        <origin xyz="-0.2 0.0  0.4" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.4 0.5 0.8" />
        </geometry>
      </collision>

      <!-- Fake inertia -->
      <inertial>
        <origin xyz="-0.2 0.0 0.0" rpy="0.0 0.0 0.0" />
        <mass value="15.0" />
        <inertia ixx="0.001111" ixy="0.0"      ixz="0.0"
                                iyy="0.001111" iyz="0.0"
                                               izz="0.001111" />
      </inertial>
    </link>

    <joint name="${component_name_underscore}to_${component_name_underscore}wibotic_transmitter_joint" type="fixed">
      <!-- This should be when docking is released for panther-docker
      <origin xyz="0.05 0.0 0.295" rpy="0.0 0.0 ${pi}" /> -->
      <origin xyz="0.05 0.0 0.5" rpy="0.0 0.0 ${pi}" />
      <parent link="${component_name_underscore}link" />
      <child link="${component_name_underscore}wibotic_transmitter_link" />
    </joint>

    <link name="${component_name_underscore}wibotic_transmitter_link" />

  </xacro:macro>

  <xacro:macro name="create_apriltag"
    params="name size:=$(arg apriltag_size) component_name:=''">

    <xacro:property name="component_name_underscore" value="${component_name + '_' if component_name != '' else ''}" />


    <link name="${component_name_underscore}${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="${size+0.02} ${size+0.02} 0.00005" />
        </geometry>
        <material name="White">
          <color rgba="1.0 1.0 1.0 1.0" />
        </material>
      </visual>
      </link>

    <joint name="${name}_to_${name}_${component_name_underscore}image_link_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 -${pi/2.0} ${pi/2.0}" />
      <parent link="${component_name_underscore}${name}_link" />
      <child link="${component_name_underscore}${name}_image_link" />
    </joint>

    <link name="${component_name_underscore}${name}_image_link">
      <collision>
        <origin xyz="0 0 0" rpy="0 ${pi/2.0} 0" />
        <geometry>
          <box size="${size+0.02} ${size+0.02} 0.0001" />
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 0 0" rpy="0 ${pi/2.0} 0" />
        <geometry>
          <box size="${size} ${size} 0.0001" />
        </geometry>
        <material name="Grey">
          <color rgba="0.15 0.15 0.15 1.0" />
        </material>
      </visual>

      <inertial>
        <mass value="1e-5" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
      </inertial>
    </link>

    <gazebo reference="${component_name_underscore}${name}_image_link">
      <visual>
        <material>
          <diffuse>1.0 1.0 1.0 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
          <ambient>1.0 1.0 1.0</ambient>
          <lighting>true</lighting>
          <emissive>0 0 0 1</emissive>
          <pbr>
            <metal>
              <albedo_map>$(arg apriltag_image_path)</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </gazebo>

    <xacro:property name="apriltag_size_prop" value="$(arg apriltag_size)" />
    <xacro:wibotic_station
      component_name="$(arg component_name)" parent_link="${component_name_underscore}${name}_image_link"  xyz="0.0 0.0 0.5"
      rpy="${pi} 0 0 " />

  </xacro:macro>

  <xacro:create_apriltag name="apriltag" component_name="$(arg component_name)" size="$(arg apriltag_size)" />

</robot>
