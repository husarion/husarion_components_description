<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="teltonika_003R-00253"
               params="parent_link
                       xyz:='0.0 0.0 0.0'
                       rpy:='0.0 0.0 0.0'
                       robot_namespace:=''
                       component_name:=''">

    <!-- <xacro:if value="${component_name == ''}">
      <xacro:property name="component_name" value="gps" />
    </xacro:if> -->
    <!-- ^ removed for compatibility with hw driver -->

    <xacro:property name="robot_namespace_slash" value="${robot_namespace + '/' if robot_namespace != '' else ''}" />
    <xacro:property name="component_name_underscore" value="${component_name + '_' if component_name != '' else ''}" />
    <xacro:property name="component_name_slash" value="${component_name + '/' if component_name != '' else ''}" />

    <xacro:property name="component_name_underscore_nonempty" value="${component_name_underscore if component_name_underscore != '' else 'gps_'}" />
    <xacro:property name="component_name_slash_nonempty" value="${component_name_slash if component_name_slash != '' else 'gps/'}" />
    <!-- ^ in case no name is provided, generate "..._link" instead of just "link" -->

    <joint name="${parent_link.rstrip('_link')}_to_${component_name_underscore_nonempty}joint"
      type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}" />
      <parent link="${parent_link}" />
      <child link="${component_name_underscore_nonempty}link" />
    </joint>

    <link name="${component_name_underscore_nonempty}link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <geometry>
          <mesh filename="package://husarion_components_description/meshes/teltonika_003R-00253.dae" />
        </geometry>
      </visual>

      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <geometry>
          <mesh
            filename="package://husarion_components_description/meshes/teltonika_003R-00253_collision.stl" />
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0.045 0.0 0.0058" rpy="0.0 0.0 0.0" />
        <mass value="0.59" />
        <inertia ixx="0.003964" ixy="0.0000000" ixz="0.0"
                                iyy="0.0003964" iyz="0.0"
                                                izz="0.0004177" />
      </inertial>
    </link>

    <joint
      name="${component_name_underscore_nonempty}to_${component_name_underscore}gps_joint"
      type="fixed">
      <origin xyz="0.045 0.0 0.0058" rpy="0.0 0.0 0.0" />
      <parent link="${component_name_underscore_nonempty}link" />
      <child link="${component_name_underscore}gps" />
    </joint>

    <link name="${component_name_underscore}gps" />

    <gazebo reference="${component_name_underscore}gps">
      <sensor name="${robot_namespace_slash}${component_name_underscore_nonempty}navsat" type="navsat">
        <plugin filename="ignition-gazebo-navsat-system" name="ignition::gazebo::systems::NavSat" />
        <always_on>1</always_on>
        <update_rate>1</update_rate>
        <topic>${robot_namespace_slash}${component_name_slash_nonempty}fix</topic>
        <gz_frame_id>${robot_namespace_slash}${component_name_underscore}gps</gz_frame_id>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
